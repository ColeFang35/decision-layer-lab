# ---------- 决策模型：TypeSafe / Jev ----------
# 控制台 https://console.typesafe.ai（注意：这台机器上它需要【直连】，
# 走系统代理 127.0.0.1:7897 会超时）
TYPESAFE_API_KEY=

# ---------- 生成式对照：OpenAI 兼容协议 ----------
# DeepSeek：https://platform.deepseek.com 建 key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 支持一次跑多个模型做对照，逗号分隔
OPENAI_MODELS=deepseek-flash,deepseek-v4-pro

# 关掉 thinking 模式能省大量输出 token 和时间（DeepSeek 默认是开的）
LLM_THINKING=disabled

# 单价覆盖（美元/百万 token），格式 "模型:输入价:输出价,模型2:..."
# 内置表见 dlayer/prices.py，查不到就记 0 —— 别拿 0 当结论
MODEL_PRICES=
